################################################################################
# First Aid AI Module 1 - Environment Configuration
#
# Copy this file to .env and update values for your environment.
# DO NOT commit .env with real secrets to version control.
# See ENV_CONFIGURATION.md for detailed setup instructions.
################################################################################

# ==============================================================================
# LEGACY COMPATIBILITY
# ==============================================================================
# Module 1 active persistence is BigQuery. DATABASE_URL remains only for
# compatibility with older scripts and should not be used as the submission DB.
DATABASE_URL=sqlite:///./firstaidai.db

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
# SECRET_KEY: Used for JWT token signing. Generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# KEEP THIS SECURE - treat as a production secret!
SECRET_KEY=your-secret-key-generate-a-strong-random-key-in-production

# JWT signing algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# Access token expiration time in minutes
# Recommended: 30 minutes for web, 60 for mobile, 24h for API keys
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================================================
# AI SERVICE CONFIGURATION (Optional)
# ==============================================================================
# The API works without these - deterministic fallback scoring is always enabled.
#
# To enable AI classification:
#   1. Sign up at https://console.groq.com
#   2. Create an API key
#   3. Set GROQ_API_KEY below
#
# Leave blank to disable AI classification (uses local scoring only).
GROQ_API_KEY=

# Groq API endpoint (do not change unless you have a custom endpoint)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Groq model to use for classification
GROQ_MODEL=llama-3.1-8b-instant

# ==============================================================================
# EMAIL VERIFICATION DELIVERY
# ==============================================================================
# Local/demo mode: does not send real email. The backend logs:
# DEV EMAIL VERIFICATION CODE for user@example.com: 123456
# DEV PASSWORD RESET CODE for user@example.com: 123456
# and, outside production, returns dev_verification_code for the frontend.
EMAIL_DELIVERY_MODE=console
APP_ENVIRONMENT=development

# Real SMTP mode: set EMAIL_DELIVERY_MODE=smtp and fill these values.
# The same SMTP settings are used for email verification and password reset codes.
#
# Brevo SMTP example:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your Brevo SMTP login
#   SMTP_PASSWORD=your Brevo SMTP key, not your Brevo account password
#   SMTP_FROM_EMAIL=a sender email verified in Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=First Aid AI
SMTP_USE_TLS=true

# Development/demo helper. When true and APP_ENVIRONMENT is not production,
# the backend prints verification/reset codes even while EMAIL_DELIVERY_MODE=smtp.
# Registration/resend also return dev_verification_code so the local frontend can
# show the code. This is useful for testing with fake inboxes. Keep false in production.
EMAIL_LOG_CODES=false

# Backward-compatible names still supported by the backend:
SMTP_SERVER=smtp-relay.brevo.com
SMTP_USER=

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed frontend origins.
#
# Development examples:
#   http://localhost:3000
#   http://localhost:5173
#   http://127.0.0.1:5173
#
# Production should use your actual domain:
#   https://yourdomain.com
#   https://www.yourdomain.com
#
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# BIGQUERY CONFIGURATION
# ==============================================================================
# BigQuery is the required persistence layer for Module 1 submission.
# Leave these blank only for local tests that intentionally use in-memory fallback.
#
# Setup steps:
#   1. Create GCP project and BigQuery dataset
#   2. Create service account with BigQuery Editor role
#   3. Download credentials JSON file
#   4. Set variables below
#
# For detailed setup: ../docs/ENV_CONFIGURATION.md

# GCP Project ID (e.g., "my-project-123456")
BIGQUERY_PROJECT_ID=

# BigQuery Dataset ID (default: "first_aid_ai_module1")
BIGQUERY_DATASET_ID=first_aid_ai_module1

# Path to Google Cloud Service Account JSON credentials file
# Leave blank to use Application Default Credentials (for local testing)
BIGQUERY_CREDENTIALS_PATH=

# Compatibility flag retained from older migration docs.
# Current Module 1 persistence is handled by BigQueryService whenever
# BIGQUERY_PROJECT_ID/client credentials are configured.
BIGQUERY_WRITE_ENABLED=false

# Read source for user/assessment data
# Compatibility setting retained from older migration docs.
# Current Module 1 API uses BigQueryService and falls back to in-memory only
# when BigQuery is not configured or unavailable.
BIGQUERY_READ_SOURCE=legacy

# Watermark for incremental backfill (ISO 8601 timestamp)
# Used in Phase 3 to track backfill progress
# Example: "2026-05-15T00:00:00Z"
BIGQUERY_BACKFILL_WATERMARK=

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
# For detailed instructions and environment-specific examples, see:
# ../docs/ENV_CONFIGURATION.md
